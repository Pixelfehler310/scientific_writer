{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Writing State Repository",
  "type": "object",
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {"const": 1},
    "projects": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state_path"],
        "properties": {
          "state_path": {"type": "string", "pattern": "^projects/[a-z0-9._-]+$"},
          "project_root_hint": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
